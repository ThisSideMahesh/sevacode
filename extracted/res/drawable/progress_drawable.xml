<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="5.0dp" />
            <gradient android:startColor="#fff" android:endColor="#c15cf4" android:angle="270.0" android:centerY="0.75" android:centerColor="#fff" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="5.0dp" />
                <gradient android:startColor="#80ffd300" android:endColor="#a0ffcb00" android:angle="270.0" android:centerY="0.75" android:centerColor="#80ffb600" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="5.0dp" />
                <gradient android:startColor="#c15cf4" android:endColor="#c15cf4" android:angle="270.0" />
            </shape>
        </clip>
    </item>
</layer-list>
