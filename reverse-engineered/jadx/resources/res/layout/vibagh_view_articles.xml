<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleX="0.75"
        android:scaleY="0.75">
        <android.support.v7.widget.CardView
            android:id="@+id/cv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardCornerRadius="10dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/imgArticle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/article1"
                    android:scaleType="centerCrop"/>
                <View
                    android:id="@+id/view"
                    android:background="@drawable/bg_shadow"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginBottom="-10dp"
                    android:layout_alignBottom="@+id/imgArticle"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    android:text="Title"
                    android:layout_alignTop="@+id/view"
                    android:fontFamily="@font/poppins_regular"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/tvDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="@dimen/factor_mdpi_10_dp"
                    android:text="Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry&apos;s standard dummy. . ."
                    android:maxLines="3"
                    android:layout_below="@+id/tvTitle"
                    android:fontFamily="@font/poppins_regular"/>
                <Button
                    android:textSize="12sp"
                    android:id="@+id/btReadMore"
                    android:background="@drawable/bt_ui_readmore"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_margin="20dp"
                    android:text="Read More"
                    android:layout_alignBottom="@+id/imgArticle"
                    android:layout_alignParentRight="true"
                    android:textAllCaps="false"
                    android:fontFamily="@font/poppins_bold"/>
            </RelativeLayout>
        </android.support.v7.widget.CardView>
    </RelativeLayout>
</RelativeLayout>
