<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/formBg"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    style="@style/parent.contentLayout">
    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/formBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/factor_mdpi_02_dp"
            android:layout_marginRight="@dimen/factor_mdpi_02_dp">
            <include layout="@layout/fragment_home_fragmen"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/factor_mdpi_10_dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="@dimen/factor_mdpi_10_dp">
                <android.support.v7.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/factor_mdpi_02_dp"
                    android:layout_marginBottom="@dimen/factor_mdpi_05_dp"
                    android:minHeight="150dp"
                    android:layout_alignParentTop="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardPreventCornerOverlap="false">
                    <include layout="@layout/header_panchang"/>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="@dimen/factor_mdpi_05_dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/font_medium_14"
                                android:textColor="@color/colorPrimaryDark"
                                android:gravity="left"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/tv_panchangs_title"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:text="पंचांग : १५ डिसेंबर २०२१"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/font_small_12"
                                android:textColor="@color/opacolorPrimaryDark"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/tv_tithi"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:text="तिथी"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="@dimen/font_small_12"
                                android:textColor="@color/opacolorPrimaryDark"
                                android:gravity="center_vertical"
                                android:id="@+id/tv_var"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="वार"
                                android:layout_weight="1.5"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/font_small_12"
                                android:textColor="@color/colorPrimaryDark"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/tv_bhadrapad"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:text="भाद्रपद"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="@dimen/font_small_12"
                                android:textColor="@color/colorPrimaryDark"
                                android:gravity="center_vertical"
                                android:id="@+id/tv_krishnakunj"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="कृष्णपक्ष"
                                android:layout_weight="1.5"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/font_small_12"
                                android:textColor="@color/opacolorPrimaryDark"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/tv_nakshatra"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:text="नक्षत्र"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="@dimen/font_small_12"
                                android:textColor="@color/opacolorPrimaryDark"
                                android:gravity="center_vertical"
                                android:id="@+id/tv_rahukal"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="राहुकाळ"
                                android:layout_weight="1.5"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/font_small_12"
                                android:textColor="@color/colorPrimaryDark"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/tv_ashle"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:text="आश्ले"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="@dimen/font_small_12"
                                android:textColor="@color/colorPrimaryDark"
                                android:gravity="center_vertical"
                                android:id="@+id/tv_datetime"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="सकाळी ९.00 ते १२.00"
                                android:layout_weight="1.5"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/font_small_12"
                                android:textColor="@color/opacolorPrimaryDark"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/tv_shubharambh"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:text="शुभारंभ"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="@dimen/font_small_12"
                                android:textColor="@color/opacolorPrimaryDark"
                                android:gravity="center_vertical"
                                android:id="@+id/tv_dinvishesh"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="दिंविशेष"
                                android:layout_weight="1.5"/>
                        </LinearLayout>
                    </LinearLayout>
                </android.support.v7.widget.CardView>
                <android.support.v7.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/factor_mdpi_10_dp"
                    android:layout_marginBottom="@dimen/factor_mdpi_05_dp"
                    android:layout_alignParentTop="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardPreventCornerOverlap="false">
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="@dimen/factor_mdpi_05_dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/font_medium_14"
                                android:textColor="@color/colorPrimaryDark"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/tv_desc_suvichar"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/font_small_12"
                                android:textColor="@color/viyatik"
                                android:gravity="right"
                                android:id="@+id/tv_title_suvichar"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="परमपूज्य गुरुमाऊली "
                                android:drawableLeft="@drawable/quote"
                                android:layout_weight="1.5"/>
                        </LinearLayout>
                    </LinearLayout>
                </android.support.v7.widget.CardView>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_marginLeft="@dimen/factor_mdpi_10_dp">
                    <TextView
                        android:layout_marginLeft="@dimen/factor_mdpi_05_dp"
                        android:text="माझी सेवा"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentTop="true"
                        style="@style/viewParent.headerText"/>
                    <TextView
                        android:textSize="@dimen/factor_mdpi_15_dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:id="@+id/txt_seva_nav"
                        android:text="सेवा नोंद करा"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        style="@style/viewParent"/>
                </RelativeLayout>
                <android.support.v7.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/factor_mdpi_02_dp"
                    android:layout_marginBottom="@dimen/factor_mdpi_05_dp"
                    android:layout_alignParentTop="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardPreventCornerOverlap="false">
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="@dimen/factor_mdpi_05_dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:padding="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:orientation="vertical"
                                android:id="@+id/thumbnail"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_marginRight="8dp"
                                android:layout_alignParentLeft="true">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/lyt_Courses"
                                    android:background="@drawable/layout_bg"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1">
                                    <TextView
                                        android:textSize="@dimen/font_medium_14"
                                        android:textColor="@color/viyatik"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:id="@+id/txt_maal_count"
                                        android:padding="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:singleLine="true"
                                        android:layout_weight="2"
                                        android:fontFamily="@font/poppins_bold"/>
                                    <TextView
                                        android:textSize="@dimen/font_small_12"
                                        android:textStyle="bold"
                                        android:textColor="@color/white"
                                        android:gravity="center"
                                        android:layout_gravity="center"
                                        android:id="@+id/txt_Weather"
                                        android:background="@drawable/sevabuttonsshapes"
                                        android:padding="@dimen/factor_mdpi_02_dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:singleLine="true"
                                        android:layout_weight="1"/>
                                </LinearLayout>
                            </LinearLayout>
                            <TextView
                                android:textSize="@dimen/factor_mdpi_15_dp"
                                android:textStyle="bold"
                                android:id="@+id/tv_title_sevamarg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toRightOf="@+id/thumbnail"
                                android:layout_alignTop="@+id/thumbnail"/>
                            <TextView
                                android:textSize="@dimen/font_small_12"
                                android:textColor="@color/newgradient_end_color"
                                android:id="@+id/tv_description_sevamarg"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="अब्जचंडी अंतर्गत सेवा नोंद करा"
                                android:maxLines="2"
                                android:layout_toRightOf="@+id/thumbnail"
                                android:layout_below="@+id/tv_title_sevamarg"/>
                            <TextView
                                android:textSize="@dimen/font_small_12"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:id="@+id/tv_added_on_sevamarg"
                                android:background="@drawable/homebuttonsshapes"
                                android:padding="@dimen/factor_mdpi_05_dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/tv_description_sevamarg"
                                android:layout_alignParentRight="true"
                                android:layout_alignParentBottom="true"/>
                        </RelativeLayout>
                    </LinearLayout>
                </android.support.v7.widget.CardView>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_marginLeft="@dimen/factor_mdpi_10_dp">
                    <TextView
                        android:layout_marginLeft="@dimen/factor_mdpi_05_dp"
                        android:text="सेवा मार्गातील 18 विभाग"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentTop="true"
                        style="@style/viewParent.headerText"/>
                    <TextView
                        android:textSize="@dimen/factor_mdpi_15_dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:id="@+id/tv_vibhag_see_all"
                        android:text="पुर्ण पहा"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        style="@style/viewParent"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <android.support.v7.widget.RecyclerView
                        android:orientation="horizontal"
                        android:id="@+id/horizontalrecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:divider="@null"
                        app:reverseLayout="true"/>
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/factor_mdpi_05_dp">
                    <TextView
                        android:layout_marginLeft="@dimen/factor_mdpi_05_dp"
                        android:text="श्री गुरुपीठ युट्युब चॅनल"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentTop="true"
                        style="@style/viewParent.headerText"/>
                    <TextView
                        android:textSize="@dimen/factor_mdpi_15_dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:id="@+id/tv_see_all"
                        android:text="पुर्ण पहा"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        style="@style/viewParent"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <android.support.v7.widget.RecyclerView
                        android:orientation="horizontal"
                        android:id="@+id/youtube_horizontalrecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:divider="@null"
                        app:reverseLayout="true"/>
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/factor_mdpi_05_dp">
                    <TextView
                        android:layout_marginLeft="@dimen/factor_mdpi_05_dp"
                        android:text="दिंडोरी प्रणित सेवा मार्ग युट्युब चॅनल"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentTop="true"
                        style="@style/viewParent.headerText"/>
                    <TextView
                        android:textSize="@dimen/factor_mdpi_15_dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:id="@+id/tv_dindori_see_all"
                        android:text="पुर्ण पहा"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        style="@style/viewParent"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="@dimen/factor_mdpi_80_dp">
                    <android.support.v7.widget.RecyclerView
                        android:orientation="horizontal"
                        android:id="@+id/dindori_youtube_horizontalrecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:divider="@null"
                        app:reverseLayout="true"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </android.support.v4.widget.NestedScrollView>
</android.support.constraint.ConstraintLayout>
