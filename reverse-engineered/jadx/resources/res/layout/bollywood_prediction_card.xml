<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/factor_mdpi_50_dp">
        <ImageView
            android:id="@+id/intro_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/im_one"
            android:layout_below="@+id/intro_description"
            android:contentDescription="@string/app_name"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/colorPrimary"
            android:id="@+id/intro_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="श्री स्वामी समर्थ मार्गदर्शिका "
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/poppins_bold"/>
        <com.dp.sgp.util.JustifiedTextView
            android:textSize="15sp"
            android:textColor="#89a3d4"
            android:id="@+id/intro_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="@dimen/factor_mdpi_10_dp"
            android:text="श्री प्रधान केंद्र दिंडोरी, श्री गुरुपीठ विषयी थोडक्यात माहिती"
            android:layout_below="@+id/intro_title"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/poppins_regular"
            android:textAlignment="center"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"/>
    </RelativeLayout>
    <android.support.constraint.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:background="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.71"/>
</android.support.constraint.ConstraintLayout>
