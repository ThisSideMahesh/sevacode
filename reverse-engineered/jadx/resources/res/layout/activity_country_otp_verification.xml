<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/layMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="24dp"
                android:layout_alignParentBottom="true">
                <ImageView
                    android:id="@+id/intro_img"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:src="@drawable/im_four"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/app_name"/>
                <TextView
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="श्री गुरुपीठ"
                    style="@style/DarkModeHidden"/>
                <TextView
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:gravity="center"
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Verification Code"
                    android:fontFamily="@font/poppins_regular"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorPrimaryDark"
                    android:gravity="center"
                    android:id="@+id/tvTSubitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Please type the verification code \10 sent to + 91 77xxxxxx83"
                    android:fontFamily="@font/poppins_regular"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/root_otp_layout_new"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="32dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="32dp"
                    android:weightSum="4">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@color/colorPrimaryDark"
                        android:gravity="center"
                        android:id="@+id/otp_text_box1"
                        android:nextFocusDown="@+id/otp_edit_box3"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginRight="20dp"
                        android:text="8"
                        android:maxLength="1"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:fontFamily="@font/poppins_bold"/>
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@color/colorPrimaryDark"
                        android:gravity="center"
                        android:id="@+id/otp_text_box2"
                        android:nextFocusDown="@+id/otp_edit_box3"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginRight="20dp"
                        android:text="8"
                        android:maxLength="1"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:fontFamily="@font/poppins_bold"/>
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@color/colorPrimaryDark"
                        android:gravity="center"
                        android:id="@+id/otp_text_box3"
                        android:nextFocusDown="@+id/otp_edit_box4"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginRight="20dp"
                        android:text="8"
                        android:maxLength="1"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:fontFamily="@font/poppins_bold"/>
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@color/colorPrimaryDark"
                        android:gravity="center"
                        android:id="@+id/otp_text_box4"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:text="8"
                        android:maxLength="1"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:fontFamily="@font/poppins_bold"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/root_otp_layout"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="32dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="32dp"
                    android:weightSum="4">
                    <EditText
                        android:textSize="18sp"
                        android:gravity="center"
                        android:id="@+id/otp_edit_box1"
                        android:background="@drawable/edittext_curve_bg"
                        android:nextFocusDown="@+id/otp_edit_box2"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginRight="20dp"
                        android:maxLength="1"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:fontFamily="@font/poppins_regular"/>
                    <EditText
                        android:textSize="18sp"
                        android:gravity="center"
                        android:id="@+id/otp_edit_box2"
                        android:background="@drawable/edittext_curve_bg"
                        android:nextFocusDown="@+id/otp_edit_box3"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginRight="20dp"
                        android:maxLength="1"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:fontFamily="@font/poppins_regular"/>
                    <EditText
                        android:textSize="18sp"
                        android:gravity="center"
                        android:id="@+id/otp_edit_box3"
                        android:background="@drawable/edittext_curve_bg"
                        android:nextFocusDown="@+id/otp_edit_box4"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginRight="20dp"
                        android:maxLength="1"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:fontFamily="@font/poppins_regular"/>
                    <EditText
                        android:textSize="18sp"
                        android:gravity="center"
                        android:id="@+id/otp_edit_box4"
                        android:background="@drawable/edittext_curve_bg"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:maxLength="1"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:fontFamily="@font/poppins_regular"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/blackTextColor"
                        android:gravity="center"
                        android:id="@+id/tv_timer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/timer"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/blackTextColor"
                        android:gravity="center"
                        android:id="@+id/tv_resend"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="RESEND OTP"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"/>
                </LinearLayout>
                <Button
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/btnVerify"
                    android:background="@drawable/button_login"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="15dp"
                    android:text="Verify"
                    android:textAllCaps="false"
                    android:fontFamily="@font/poppins_regular"
                    style="@style/TextAppearance.AppCompat.Widget.Button.Colored"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</LinearLayout>
