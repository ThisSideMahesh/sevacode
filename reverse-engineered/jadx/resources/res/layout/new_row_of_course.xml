<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="6dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">
    <RelativeLayout
        android:orientation="horizontal"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/thumbnail"
            android:padding="3dp"
            android:layout_width="@dimen/factor_mdpi_50_dp"
            android:layout_height="50dp"
            android:layout_marginRight="@dimen/factor_mdpi_05_dp"
            android:layout_alignParentLeft="true">
            <ImageView
                android:id="@+id/image_user"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@mipmap/ic_launcher"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/new_textcolor"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/pos"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginRight="5dp"
                android:text="25"
                android:fontFamily="@font/poppins_bold"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/factor_mdpi_15_dp"
            android:textStyle="bold"
            android:textColor="@color/new_textcolor"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/factor_mdpi_05_dp"
            android:text="Rihanna Love the way lie"
            android:layout_toRightOf="@+id/thumbnail"
            android:layout_alignTop="@+id/thumbnail"/>
        <TextView
            android:textSize="@dimen/font_small_12"
            android:textStyle="bold"
            android:textColor="@color/light_textcolor"
            android:id="@+id/timing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/factor_mdpi_05_dp"
            android:layout_marginTop="1dp"
            android:text="ऑफलाइन मोडमध्ये कार्य करेल"
            android:layout_toRightOf="@+id/thumbnail"
            android:layout_below="@+id/title"/>
        <TextView
            android:textSize="@dimen/factor_mdpi_08_dp"
            android:textColor="#504f60"
            android:id="@+id/artist"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="2 hours 20 min"
            android:drawablePadding="5dp"
            android:layout_toRightOf="@+id/thumbnail"
            android:layout_below="@+id/timing"
            android:fontFamily="@font/poppins_regular"/>
        <LinearLayout
            android:gravity="right"
            android:padding="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <RelativeLayout
                android:background="#00000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/image"
                    android:layout_width="@dimen/factor_mdpi_30_dp"
                    android:layout_height="@dimen/factor_mdpi_30_dp"
                    app:srcCompat="@drawable/ic_baseline_check_circle_24_green"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</android.support.v7.widget.CardView>
