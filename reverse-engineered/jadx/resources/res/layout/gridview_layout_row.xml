<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/android_custom_gridview_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/factor_mdpi_10_dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/tab_indicator_gray"
            android:gravity="left"
            android:id="@+id/txt_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/factor_mdpi_15_dp"
            android:layout_marginTop="@dimen/factor_mdpi_02_dp"
            android:text="Hello"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimaryDark"
            android:gravity="right"
            android:id="@+id/txt_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/factor_mdpi_15_dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="15dp"
            android:text="Monish"
            android:drawableRight="@drawable/ic_baseline_arrow_forward_ios_24_for"
            android:drawablePadding="@dimen/factor_mdpi_05_dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/title_lag"
            android:paddingLeft="@dimen/factor_mdpi_05_dp"
            android:paddingTop="@dimen/factor_mdpi_05_dp"
            android:paddingRight="@dimen/factor_mdpi_05_dp"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:fontFamily="@font/poppins_bold"/>
    </LinearLayout>
</LinearLayout>
