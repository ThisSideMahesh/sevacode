<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/lyt_mahcine_main"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/textView"
            android:background="@drawable/black_custom_tab_header"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:src="@drawable/mask_group">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/factor_mdpi_15_dp"
                android:layout_weight="1">
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/groupradio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/factor_mdpi_05_dp">
                    <RadioButton
                        android:textSize="@dimen/factor_mdpi_15_dp"
                        android:textColor="@color/colorPrimaryDark"
                        android:id="@+id/radia_id1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="वैयक्तिक"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"/>
                    <RadioButton
                        android:textSize="@dimen/factor_mdpi_15_dp"
                        android:textColor="@color/colorPrimaryDark"
                        android:id="@+id/radia_id2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="कौटूंबिक"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"/>
                    <RadioButton
                        android:textSize="@dimen/factor_mdpi_15_dp"
                        android:textColor="@color/colorPrimaryDark"
                        android:id="@+id/radia_id3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="सामुदायिक"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"/>
                </RadioGroup>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <EditText
                    android:textSize="@dimen/factor_mdpi_15_dp"
                    android:textColor="@color/colorPrimaryDark"
                    android:textColorHint="#afafaf"
                    android:id="@+id/edt_BlanksReceived"
                    android:background="@drawable/btn_edittext_new"
                    android:paddingLeft="20dp"
                    android:paddingRight="10dp"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="@dimen/factor_mdpi_15_dp"
                    android:hint="वैयक्तिक (स्वतःचे नाव)"
                    android:singleLine="true"
                    android:inputType="textCapCharacters"
                    android:imeOptions="actionNext"
                    android:fontFamily="@font/poppins_regular"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/factor_mdpi_10_dp"
            android:layout_below="@+id/textView">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/tab_indicator_gray"
                android:gravity="center"
                android:id="@+id/txtSwipeRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="खालीलपैकी सेवेची निवड करा"
                android:layout_centerVertical="true"
                android:fontFamily="@font/poppins_medium"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <android.support.v7.widget.RecyclerView
                    android:id="@+id/my_recycler_view"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginLeft="@dimen/factor_mdpi_05_dp"
                    android:layout_marginTop="@dimen/factor_mdpi_05_dp"
                    android:layout_marginRight="@dimen/factor_mdpi_05_dp"
                    android:layout_marginBottom="@dimen/factor_mdpi_05_dp"
                    android:layout_weight="1"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/factor_mdpi_15_dp"
                    android:layout_marginRight="@dimen/factor_mdpi_15_dp"
                    android:layout_marginBottom="@dimen/factor_mdpi_05_dp"
                    android:layout_weight="0">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:id="@+id/main"
                        android:background="@drawable/buttonsshapes"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/factor_mdpi_50_dp"
                        app:layout_constraintTop_toBottomOf="@+id/textView2">
                        <TextView
                            android:textSize="18sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Submit"
                            android:drawableLeft="@drawable/ic_baseline_check_circle_24"
                            android:drawablePadding="@dimen/factor_mdpi_10_dp"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/poppins_medium"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</android.support.constraint.ConstraintLayout>
