<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <android.support.v7.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/card_margin"
        card_view:cardBackgroundColor="@color/whiteBodyColor"
        card_view:cardCornerRadius="7dp"
        card_view:cardElevation="5dp"
        card_view:cardPreventCornerOverlap="false">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/youtubeThubnail"
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="@dimen/frutorial_title"
                android:textColor="@color/frutorial_title"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="@string/timer"
                android:layout_below="@+id/youtubeThubnail"
                android:fontFamily="@font/poppins_regular"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-40dp"
                android:layout_below="@+id/youtubeThubnail"
                android:layout_centerInParent="true"
                android:layout_centerHorizontal="true"
                card_view:srcCompat="@drawable/ic_baseline_play_circle_outline_24"/>
        </RelativeLayout>
    </android.support.v7.widget.CardView>
</LinearLayout>
