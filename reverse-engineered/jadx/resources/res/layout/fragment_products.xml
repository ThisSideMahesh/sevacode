                                            android:padding="@dimen/factor_mdpi_10_dp"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:singleLine="true"
                                            android:layout_below="@+id/image_main2"/>
                                    </RelativeLayout>
                                </LinearLayout>
                                <LinearLayout
