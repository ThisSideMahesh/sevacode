<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#00000000"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/shriyantra"
        android:scaleType="fitXY"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.widget.RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/cv_slider_mainActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_alignParentTop="true">
                <com.dp.sgp.autoimageslider.SliderView
                    android:id="@+id/imageSlider"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    app:sliderAnimationDuration="600"
                    app:sliderAutoCycleDirection="back_and_forth"
                    app:sliderIndicatorAnimationDuration="600"
                    app:sliderIndicatorEnabled="true"
                    app:sliderIndicatorGravity="bottom|center_horizontal"
                    app:sliderIndicatorMargin="15dp"
                    app:sliderIndicatorOrientation="horizontal"
                    app:sliderIndicatorPadding="3dp"
                    app:sliderIndicatorRadius="2dp"
                    app:sliderIndicatorSelectedColor="@color/colorPrimaryDark"
                    app:sliderIndicatorUnselectedColor="@color/iron"
                    app:sliderScrollTimeInSec="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:layout_below="@+id/cv_slider_mainActivity">
                <android.support.v4.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/factor_mdpi_02_dp"
                        android:layout_marginRight="@dimen/factor_mdpi_02_dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/factor_mdpi_05_dp">
                            <TextView
                                android:textColor="@color/colorPrimaryDark"
                                android:layout_marginLeft="@dimen/factor_mdpi_05_dp"
                                android:text="सर्वात लोकप्रिय"
                                android:layout_alignParentLeft="true"
                                android:layout_alignParentTop="true"
                                style="@style/viewParent.headerText"/>
                            <TextView
                                android:textSize="@dimen/factor_mdpi_15_dp"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimaryDark"
                                android:id="@+id/txt_lokpriya_view"
                                android:text="संपुर्ण पहा &gt;&gt;"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                style="@style/viewParent"/>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/factor_mdpi_05_dp">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_weight="1">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="@dimen/factor_mdpi_05_dp"
                                    android:layout_weight="1">
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent">
                                        <FrameLayout
                                            android:layout_gravity="center"
                                            android:id="@+id/image_main1"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content">
                                            <ImageView
                                                android:gravity="center"
                                                android:layout_gravity="center"
                                                android:id="@+id/title_lag1"
                                                android:layout_width="wrap_content"
                                                android:layout_height="100dp"
                                                android:src="@drawable/card_dattdham"
                                                android:scaleType="fitXY"/>
                                        </FrameLayout>
                                        <TextView
                                            android:textSize="@dimen/font_medium_14"
                                            android:textStyle="bold"
                                            android:textColor="@color/colorPrimaryDark"
                                            android:gravity="center"
                                            android:id="@+id/title1"
                                            android:background="@color/white"
                                            android:padding="@dimen/factor_mdpi_10_dp"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:singleLine="true"
                                            android:layout_below="@+id/image_main1"/>
                                    </RelativeLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="@dimen/factor_mdpi_05_dp"
                                    android:layout_weight="1">
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent">
                                        <FrameLayout
                                            android:layout_gravity="center"
                                            android:id="@+id/image_main"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content">
                                            <ImageView
                                                android:gravity="center"
                                                android:layout_gravity="center"
                                                android:id="@+id/title_lag"
                                                android:layout_width="wrap_content"
                                                android:layout_height="100dp"
                                                android:src="@drawable/card_dattdham"
                                                android:scaleType="fitXY"/>
                                        </FrameLayout>
                                        <TextView
                                            android:textSize="@dimen/font_medium_14"
                                            android:textStyle="bold"
                                            android:textColor="@color/colorPrimaryDark"
                                            android:gravity="center"
                                            android:id="@+id/title"
                                            android:background="@color/white"
                                            android:padding="@dimen/factor_mdpi_10_dp"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:singleLine="true"
                                            android:layout_below="@+id/image_main"/>
                                    </RelativeLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <android.support.v7.widget.RecyclerView
