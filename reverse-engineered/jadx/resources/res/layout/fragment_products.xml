                                                android:layout_gravity="center"
                                                android:id="@+id/title_lag3"
                                                android:layout_width="wrap_content"
                                                android:layout_height="100dp"
                                                android:src="@drawable/card_dattdham"
                                                android:scaleType="fitXY"/>
                                        </FrameLayout>
                                        <TextView
