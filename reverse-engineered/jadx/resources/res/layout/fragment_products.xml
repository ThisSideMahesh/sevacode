                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_weight="1">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="@dimen/factor_mdpi_05_dp"
                                    android:layout_weight="1">
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent">
                                        <FrameLayout
                                            android:layout_gravity="center"
                                            android:id="@+id/image_main4"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content">
                                            <ImageView
                                                android:gravity="center"
                                                android:layout_gravity="center"
                                                android:id="@+id/title_lag4"
                                                android:layout_width="wrap_content"
                                                android:layout_height="100dp"
                                                android:src="@drawable/card_dattdham"
                                                android:scaleType="fitXY"/>
                                        </FrameLayout>
                                        <TextView
                                            android:textSize="@dimen/font_medium_14"
                                            android:textStyle="bold"
                                            android:textColor="@color/colorPrimaryDark"
                                            android:gravity="center"
                                            android:id="@+id/title4"
                                            android:background="@color/white"
                                            android:padding="@dimen/factor_mdpi_10_dp"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:singleLine="true"
                                            android:layout_below="@+id/image_main4"/>
                                    </RelativeLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="@dimen/factor_mdpi_05_dp"
                                    android:layout_weight="1">
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent">
                                        <FrameLayout
                                            android:layout_gravity="center"
                                            android:id="@+id/image_main8"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content">
                                            <ImageView
                                                android:gravity="center"
                                                android:layout_gravity="center"
                                                android:id="@+id/title_lag8"
                                                android:layout_width="wrap_content"
                                                android:layout_height="100dp"
                                                android:src="@drawable/card_dattdham"
                                                android:scaleType="fitXY"/>
                                        </FrameLayout>
                                        <TextView
                                            android:textSize="@dimen/font_medium_14"
                                            android:textStyle="bold"
                                            android:textColor="@color/colorPrimaryDark"
                                            android:gravity="center"
                                            android:id="@+id/title8"
                                            android:background="@color/white"
                                            android:padding="@dimen/factor_mdpi_10_dp"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:singleLine="true"
                                            android:layout_below="@+id/image_main8"/>
                                    </RelativeLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <android.support.v7.widget.RecyclerView
                                android:orientation="horizontal"
                                android:id="@+id/rv_aaruvedh_utpadan"
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:divider="@null"
                                app:reverseLayout="true"/>
                        </LinearLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/factor_mdpi_05_dp">
                            <TextView
                                android:textColor="@color/colorPrimaryDark"
                                android:layout_marginLeft="@dimen/factor_mdpi_05_dp"
                                android:text="कृषी उत्पादने"
                                android:layout_alignParentLeft="true"
                                android:layout_alignParentTop="true"
                                style="@style/viewParent.headerText"/>
                            <TextView
                                android:textSize="@dimen/factor_mdpi_15_dp"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimaryDark"
                                android:id="@+id/txt_krishi_view"
                                android:text="संपुर्ण पहा &gt;&gt;"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                style="@style/viewParent"/>
