                                android:id="@+id/rv_lokpriya"
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:divider="@null"
                                app:reverseLayout="true"/>
                        </LinearLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/factor_mdpi_05_dp">
                            <TextView
                                android:textColor="@color/colorPrimaryDark"
                                android:layout_marginLeft="@dimen/factor_mdpi_05_dp"
                                android:text="पूजा साहित्य"
                                android:layout_alignParentLeft="true"
                                android:layout_alignParentTop="true"
                                style="@style/viewParent.headerText"/>
                            <TextView
                                android:textSize="@dimen/factor_mdpi_15_dp"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimaryDark"
                                android:id="@+id/txt_pooja_view"
                                android:text="संपुर्ण पहा &gt;&gt;"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                style="@style/viewParent"/>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/factor_mdpi_05_dp">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:layout_weight="1">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
