<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/factor_mdpi_10_dp"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">
        <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/tvMyArticle"
                android:background="@drawable/buttonsshapes"
                android:layout_width="match_parent"
                android:layout_height="@dimen/factor_mdpi_50_dp"
                android:layout_margin="@dimen/factor_mdpi_10_dp"
                app:layout_constraintTop_toBottomOf="@+id/textView2">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/txt_cat"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginLeft="@dimen/factor_mdpi_15_dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="5dp"
                    android:text="But Now"
                    android:drawableLeft="@drawable/bag_new"
                    android:drawablePadding="@dimen/factor_mdpi_10_dp"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/poppins_medium"/>
            </LinearLayout>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/white"
                android:gravity="bottom|center_horizontal"
                android:background="@drawable/buttonsshapes"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buy Now"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvMyArticle"/>
        </android.support.constraint.ConstraintLayout>
    </android.support.v4.widget.NestedScrollView>
</RelativeLayout>
