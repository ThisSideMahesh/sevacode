<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/formBg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/lyt_header"
        layout="@layout/calheader"/>
    <com.dp.sgp.compactcalendarview.CompactCalendarView
        android:id="@+id/compactcalendar_view"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        app:compactCalendarBackgroundColor="@color/calbg"
        app:compactCalendarCurrentDayBackgroundColor="@color/colorAccent"
        app:compactCalendarCurrentDayIndicatorStyle="fill_large_indicator"
        app:compactCalendarCurrentDayTextColor="@color/caltext"
        app:compactCalendarCurrentSelectedDayBackgroundColor="@color/colorAccent"
        app:compactCalendarDisplayOtherMonthDays="true"
        app:compactCalendarEventIndicatorStyle="fill_large_indicator"
        app:compactCalendarMultiEventIndicatorColor="@color/gradientLightBlue"
        app:compactCalendarOtherMonthDaysTextColor="@color/theme_accent"
        app:compactCalendarShouldSelectFirstDayOfMonthOnScroll="true"
        app:compactCalendarTargetHeight="250dp"
        app:compactCalendarTextColor="@color/caltext"
        app:compactCalendarTextSize="12sp"/>
    <Button
        android:id="@+id/prev_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scroll Left"
        android:layout_below="@+id/compactcalendar_view"
        android:layout_alignParentLeft="true"/>
    <Button
        android:id="@+id/next_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scroll Right"
        android:layout_below="@+id/compactcalendar_view"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/calendar_control_buttons"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/prev_button">
        <Button
            android:id="@+id/set_locale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Locale"
            android:layout_below="@+id/compactcalendar_view"/>
        <Button
            android:id="@+id/remove_all_events"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remove all events"
            android:layout_below="@+id/compactcalendar_view"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/calendar_control_buttons_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/calendar_control_buttons">
        <Button
            android:id="@+id/slide_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Slide animation"/>
        <Button
            android:id="@+id/show_with_animation_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expose animation"/>
    </LinearLayout>
    <ListView
        android:id="@+id/bookings_listview"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/calendar_control_buttons_2"/>
    <android.support.v7.widget.RecyclerView
        android:id="@+id/rv_audio_video"
        android:background="@android:color/transparent"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/factor_mdpi_05_dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:layout_below="@+id/calendar_control_buttons_2"/>
    <include layout="@layout/no_tms_schedule"/>
</LinearLayout>
