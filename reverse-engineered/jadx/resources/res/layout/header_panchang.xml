<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/factor_mdpi_05_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:padding="@dimen/factor_mdpi_02_dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/factor_mdpi_02_dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="पंचांग :"
                    android:layout_weight="7"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textColor="@color/colorPrimaryDark"
                    android:id="@+id/tv_panchangs_title"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="पंचांग"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:padding="@dimen/factor_mdpi_02_dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/factor_mdpi_02_dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="तिथी :"
                    android:layout_weight="2.5"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textColor="@color/colorPrimaryDark"
                    android:id="@+id/tv_tithi"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="तिथी"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="वार :"
                    android:layout_weight="2.5"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textColor="@color/colorPrimaryDark"
                    android:id="@+id/tv_var"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="वार"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:padding="@dimen/factor_mdpi_02_dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/factor_mdpi_02_dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="भाद्रपद :"
                    android:layout_weight="1"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:id="@+id/tv_bhadrapad"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="भाद्रपद"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="कृष्णपक्ष :"
                    android:layout_weight="1"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:id="@+id/tv_krishnakunj"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="कृष्णपक्ष"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:padding="@dimen/factor_mdpi_02_dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/factor_mdpi_02_dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="नक्षत्र :"
                    android:layout_weight="2.5"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textColor="@color/colorPrimaryDark"
                    android:id="@+id/tv_nakshatra"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="नक्षत्र"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="राहुकाळ :"
                    android:layout_weight="2.5"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textColor="@color/colorPrimaryDark"
                    android:id="@+id/tv_rahukal"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="राहुकाळ"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:padding="@dimen/factor_mdpi_02_dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/factor_mdpi_02_dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="शुभाशुभ :"
                    android:layout_weight="2.5"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textColor="@color/colorPrimaryDark"
                    android:id="@+id/tv_shubharambh"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="शुभारंभ"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="दिनविशेष :"
                    android:layout_weight="2.5"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:textSize="@dimen/font_small_12"
                    android:textColor="@color/colorPrimaryDark"
                    android:id="@+id/tv_dinvishesh"
                    android:padding="@dimen/factor_mdpi_02_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="दिंविशेष"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/font_small_12"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryDark"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_ashle"
                android:padding="@dimen/factor_mdpi_05_dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="आश्ले"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/font_small_12"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryDark"
                android:gravity="center_vertical"
                android:id="@+id/tv_datetime"
                android:padding="@dimen/factor_mdpi_05_dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="सकाळी ९.00 ते १२.00"
                android:layout_weight="1.5"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
