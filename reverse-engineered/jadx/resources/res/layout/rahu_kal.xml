<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/tvTitle"
            android:background="@color/colorPrimary"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="राहू काळ"/>
        <ImageView
            android:id="@+id/ivClose"
            android:padding="@dimen/padding_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_cancel"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <TextView
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="(अयोग्य वेळ टाळा)"/>
    <WebView
        android:id="@+id/newweb"
        android:layout_width="match_parent"
        android:layout_height="300dp"/>
    <TableLayout
        android:orientation="vertical"
        android:background="@color/blackTextColor"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0.2dp"
        android:stretchColumns="*">
        <TableRow android:orientation="horizontal">
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="रविवार"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="सायंकाळ"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="४.३०  ते  ६.००"/>
        </TableRow>
        <TableRow android:orientation="horizontal">
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="सोमवार"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="सकाळ"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="७.३०  ते  ९.००"/>
        </TableRow>
        <TableRow android:orientation="horizontal">
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="मंगळवार"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="दुपार"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="३.०० ते ४.३०"/>
        </TableRow>
        <TableRow android:orientation="horizontal">
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="बुधवार"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="दुपार"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="१२.००  ते  १.३० "/>
        </TableRow>
        <TableRow android:orientation="horizontal">
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="गुरुवार"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="दुपार"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="१.३० ते ३.०० "/>
        </TableRow>
        <TableRow android:orientation="horizontal">
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="शुक्रवार"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="सकाळ"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="१०.३०  ते  १२.०० "/>
        </TableRow>
        <TableRow android:orientation="horizontal">
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="शनिवार"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="सकाळ"/>
            <TextView
                android:textColor="@color/blackTextColor"
                android:gravity="center_horizontal"
                android:background="@color/yellow_lt"
                android:layout_margin="0.2dp"
                android:text="९.०० ते १०.३० "/>
        </TableRow>
    </TableLayout>
    <TextView
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="वर दिलेल्या वेळेस दीड तास त्या त्या वारास महत्वाची कामे टाळावीत. सुयोग्य वेळ नसल्याने काम सहसा यशस्वी होत नाही."/>
</LinearLayout>
