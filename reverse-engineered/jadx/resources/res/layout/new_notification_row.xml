<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/factor_mdpi_05_dp">
    <RelativeLayout
        android:id="@+id/container"
        android:background="@drawable/card_bg"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/main_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginRight="@dimen/factor_mdpi_10_dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="30dp"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="@dimen/factor_mdpi_13_dp"
                android:textStyle="bold"
                android:textColor="@color/blackTextColor"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod "/>
            <TextView
                android:textSize="@dimen/font_small_12"
                android:textColor="@color/truevalue"
                android:id="@+id/releaseYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/factor_mdpi_05_dp"
                android:layout_marginBottom="@dimen/factor_mdpi_05_dp"
                android:text="10/10/2019"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>
        <WebView
            android:id="@+id/web_view"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:layout_marginRight="16dp"
            android:layout_below="@+id/main_layout"
            android:layout_alignLeft="@+id/main_layout"
            android:layout_alignStart="@+id/main_layout"/>
        <TextView
            android:textSize="@dimen/factor_mdpi_11_dp"
            android:textColor="@color/tab_inactive"
            android:id="@+id/tv_description"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginRight="16dp"
            android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. "
            android:layout_below="@+id/main_layout"
            android:layout_alignLeft="@+id/main_layout"
            android:lineSpacingExtra="8dp"
            android:layout_alignStart="@+id/main_layout"/>
        <TextView
            android:textSize="@dimen/factor_mdpi_10_dp"
            android:textColor="@color/truevalue"
            android:gravity="center"
            android:id="@+id/tv_date1"
            android:background="@drawable/bg_grey_counter"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/factor_mdpi_05_dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="66dp"
            android:layout_marginBottom="@dimen/factor_mdpi_10_dp"
            android:text="Read"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginEnd="6dp"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textColor="#2962ff"
            android:gravity="center"
            android:background="@drawable/new_notification_grey_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/factor_mdpi_10_dp"
            android:text="New"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/poppins_regular"/>
        <FrameLayout
            android:id="@+id/layoutDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/factor_mdpi_05_dp"
            android:layout_below="@+id/web_view"
            android:layout_marginStart="30dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/imag_url"
                android:layout_width="@dimen/font_large_16"
                android:layout_height="@dimen/font_large_16"
                android:layout_marginRight="5dp"
                android:src="@drawable/ic_baseline_date_range_24"/>
            <TextView
                android:textSize="@dimen/factor_mdpi_10_dp"
                android:textColor="@color/colorPrimary"
                android:layout_gravity="center"
                android:id="@+id/publishedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="23dp"
                android:layout_marginRight="10dp"
                android:text="01 January 1990"
                android:singleLine="true"
                android:fontFamily="@font/poppins_light"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/factor_mdpi_10_dp"
            android:textColor="@color/truevalue"
            android:gravity="center"
            android:id="@+id/tv_date"
            android:background="@drawable/bg_grey_counter"
            android:padding="@dimen/factor_mdpi_05_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/factor_mdpi_05_dp"
            android:layout_marginRight="16dp"
            android:text="Open"
            android:layout_below="@+id/layoutDate"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginEnd="16dp"/>
    </RelativeLayout>
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/img_user"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/container"
        app:layout_constraintStart_toStartOf="@+id/container"
        app:layout_constraintTop_toTopOf="@+id/container"
        app:srcCompat="@drawable/ic_notifications_yellow_800_48dp"/>
</android.support.constraint.ConstraintLayout>
