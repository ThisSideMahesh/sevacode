<?xml version="1.0" encoding="utf-8"?>
<com.dp.sgp.util.SquareLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/rectangle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="0.2dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/lyt_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="2dp"
            android:src="@drawable/ic_chaturthi_legend"/>
        <TextView
            android:textSize="@dimen/font_medium_14"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvDate"
            android:padding="@dimen/padding_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/factor_mdpi_05_dp"
            android:layout_marginTop="@dimen/factor_mdpi_02_dp"
            android:layout_marginRight="@dimen/factor_mdpi_05_dp"
            android:text="monish"
            android:layout_centerInParent="true"/>
    </LinearLayout>
</com.dp.sgp.util.SquareLayout>
